# Copy this to .env before running docker compose up.

# A long, random string used to sign login sessions. Generate one with:
#   openssl rand -hex 32
JWT_SECRET=change-me-to-a-long-random-string

# A 32-byte key (64 hex characters) used to encrypt stored Nextcloud
# passwords at rest. Generate one with:
#   openssl rand -hex 32
ENCRYPTION_KEY=change-me-to-a-64-char-hex-string

# The public URL where people will reach the website (used for CORS).
PUBLIC_URL=http://localhost:3000

# The public URL where the backend (API + WebDAV) is reachable. If you're
# routing both through one domain via a reverse proxy with path-based rules
# (e.g. Nginx Proxy Manager custom locations for /api and /webdav), this is
# the SAME domain as PUBLIC_URL.
PUBLIC_API_URL=http://localhost:4000

# How many reverse-proxy hops sit in front of GoodShare (Nginx Proxy
# Manager, Cloudflare, …). Needed so the backend reads the real visitor IP
# from X-Forwarded-For instead of the proxy's — otherwise every visitor
# would share one rate-limit bucket. 1 is correct for the standard NPM
# setup this project documents; raise it if you add another proxy in front.
TRUST_PROXY_HOPS=1

# Optional: loosen the built-in rate limits (per IP) if your instance has
# unusual traffic patterns. The defaults are already sized for a small,
# personal/team instance and don't need to be set.
# RATE_LIMIT_LOGIN_MAX=20
# RATE_LIMIT_PIN_LOGIN_MAX=10
# RATE_LIMIT_SHARE_UNLOCK_MAX=15
# RATE_LIMIT_REGISTRATION_MAX=50
# RATE_LIMIT_QUICK_SHARE_MAX=60

# Optional: lets people sign in via an external identity provider (SSO)
# instead of (or in addition to) email/password — e.g. a self-hosted
# Authentik instance. Leave OIDC_ISSUER_URL empty to leave this switched
# off entirely; no login button for it will appear.
#
# Set OIDC_ISSUER_URL to your provider's issuer URL (Authentik: the
# "OpenID Configuration Issuer" shown on the application/provider, usually
# something like https://auth.your-domain.example/application/o/goodshare/).
# Create an OAuth2/OpenID provider in Authentik with:
#   - Client type: Confidential
#   - Redirect URI: https://<PUBLIC_API_URL>/api/auth/sso/callback
# then copy its Client ID/Secret below.
OIDC_ISSUER_URL=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
# Shown on the login button ("Mit <name> anmelden"). Defaults to Authentik.
OIDC_PROVIDER_NAME=Authentik

# Optional: lets GoodShare send "your backup is overdue" reminder emails.
# Leave SMTP_HOST empty to leave this feature switched off entirely.
# These are server-wide settings — every account just enters how many days
# to wait, the actual sending always goes through this one mail account.
SMTP_HOST=
SMTP_PORT=587
# "true" for implicit TLS (usually port 465), "false" for STARTTLS/plain
# (usually port 587 or 25).
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
# The "From" address on reminder emails. Defaults to SMTP_USER if unset.
SMTP_FROM=goodshare@your-domain.example

# Optional: storage limit per account in MB for accounts without an
# individual limit (the admin can set one per account on the admin page).
# Leave empty for no limit.
DEFAULT_QUOTA_MB=

# Optional: how long deleted notes stay in the trash before they're gone
# for good (also covers deletions GoodNotes makes over WebDAV).
TRASH_RETENTION_DAYS=30

# Optional: text recognition makes handwritten pages and scans searchable.
# It runs in the background but is CPU-heavy; set to false on very small
# servers. The language data (German + English) ships with the image.
OCR_ENABLED=true
