# Copy this to .env before running docker compose up.

# A long, random string used to sign login sessions. Generate one with:
#   openssl rand -hex 32
JWT_SECRET=change-me-to-a-long-random-string

# A 32-byte key (64 hex characters) used to encrypt stored Nextcloud
# passwords at rest. Generate one with:
#   openssl rand -hex 32
ENCRYPTION_KEY=change-me-to-a-64-char-hex-string

# The public URL where people will reach the website (used for CORS).
PUBLIC_URL=http://localhost:3000

# The public URL where the backend (API + WebDAV) is reachable. If you're
# routing both through one domain via a reverse proxy with path-based rules
# (e.g. Nginx Proxy Manager custom locations for /api and /webdav), this is
# the SAME domain as PUBLIC_URL.
PUBLIC_API_URL=http://localhost:4000
