# Copy this to .env before running docker compose up.

# A long, random string used to sign login sessions. Generate one with:
#   openssl rand -hex 32
JWT_SECRET=change-me-to-a-long-random-string

# The public URL where people will reach the website (used for CORS).
PUBLIC_URL=http://localhost:3000

# The public URL where the backend (API + WebDAV) is reachable.
# In production this is usually a subdomain, e.g. https://api.example.com
PUBLIC_API_URL=http://localhost:4000
